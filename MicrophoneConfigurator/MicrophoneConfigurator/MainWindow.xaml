<Window x:Class="MicrophoneConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MicrophoneConfigurator.ViewModels"
        xmlns:vc="clr-namespace:MicrophoneConfigurator.Core"
        Title="MicStudio Pro"
        Height="820" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vc:EqualizerBandModel}">
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding FrequencyLabel}" Foreground="#FFB0B0D0" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <Slider Grid.Row="1" Minimum="-12" Maximum="12" Value="{Binding Gain}"
                        Orientation="Vertical" HorizontalAlignment="Center"
                        Width="18" Height="100" Style="{StaticResource PurpleSlider}"
                        ToolTip="{Binding FrequencyLabel}"/>
                <TextBlock Grid.Row="2" Text="{Binding GainDisplay}" Foreground="#FF8080C0" FontSize="8"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#FF0A0A1A" CornerRadius="14" BorderBrush="#2A2A5A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- TITLE BAR (Row 0)                            -->
            <!-- ============================================ -->
            <Grid Grid.Row="0" Background="#FF0C0C24" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="#FF00E676" Margin="0,0,8,0"/>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="MICSTUDIO" Foreground="#FFB0B0D0" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="PRO" Foreground="#FF6A6AA0" FontSize="7" FontWeight="SemiBold" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinimizeBtn" Content="─"
                            FontSize="14" Width="28" Height="28"
                            Style="{StaticResource ModernButton}" Click="MinimizeBtn_Click"
                            ToolTip="Свернуть" Margin="2,0"/>
                    <Button x:Name="TrayBtn" Content="□"
                            FontSize="14" Width="28" Height="28"
                            Style="{StaticResource ModernButton}" Click="TrayBtn_Click"
                            ToolTip="Свернуть в трей" Margin="2,0"/>
                    <Button x:Name="CloseBtn" Content="✕"
                            FontSize="14" Width="28" Height="28"
                            Style="{StaticResource DangerButton}" Click="CloseBtn_Click"
                            ToolTip="Закрыть" Margin="2,0"/>
                </StackPanel>
            </Grid>

            <!-- ============================================ -->
            <!-- MAIN CONTENT (Row 1)                         -->
            <!-- ============================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR (Column 0) -->
                <Border Grid.Column="0" Background="#FF0C0C24" BorderThickness="0,0,1,0" BorderBrush="#2A2A5A">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,8,6,8">
                        <StackPanel>

                            <!-- VU Meter Card -->
                            <Border Background="#FF16163A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="VU МЕТР" Foreground="#FFB0B0D0" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="L" Foreground="#FF8080B0" FontSize="8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Border Grid.Column="1" Background="#FF0A0A1A" CornerRadius="3" Height="8" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Border x:Name="VuLeftBar" HorizontalAlignment="Left" Background="#FF00E676" CornerRadius="3" Height="8" Width="0"/>
                                                <Border x:Name="VuLeftPeak" HorizontalAlignment="Left" Background="#FFFF5252" CornerRadius="1" Height="8" Width="1" Margin="0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="2" x:Name="VuPeakLabel" Text="0.0" Foreground="#FF8080B0" FontSize="7" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="R" Foreground="#FF8080B0" FontSize="8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Border Grid.Column="1" Background="#FF0A0A1A" CornerRadius="3" Height="8" HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Border x:Name="VuRightBar" HorizontalAlignment="Left" Background="#FF00E676" CornerRadius="3" Height="8" Width="0"/>
                                                <Border x:Name="VuRightPeak" HorizontalAlignment="Left" Background="#FFFF5252" CornerRadius="1" Height="8" Width="1"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Master Volume Card -->
                            <Border Background="#FF16163A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="МАСТЕР" Foreground="#FFB0B0D0" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" Value="75"
                                            Style="{StaticResource ModernSlider}" Margin="0,0,0,2"
                                            ToolTip="Громкость основного выхода"/>
                                    <TextBlock x:Name="VolumeDisplayText" Text="75%" Foreground="#FF8080C0" FontSize="8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Gain Reduction Meter Card -->
                            <Border Background="#FF16163A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="СНИЖЕНИЕ" Foreground="#FFB0B0D0" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border Background="#FF0A0A1A" CornerRadius="3" Height="8" Margin="0,0,0,3">
                                        <Grid>
                                            <Border x:Name="GainReductionBar" HorizontalAlignment="Left" Background="#FFFFAB40" CornerRadius="3" Height="8" Width="0"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="GainReductionLabel" Text="0.0 dB" Foreground="#FF8080B0" FontSize="8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Noise Gate Card -->
                            <Border Background="#FF16163A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="ШУМОЗАТОР" Foreground="#FFB0B0D0" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="NoiseGateToggle" Content="Включён"
                                              Foreground="#FFB0B0D0" FontSize="9" IsChecked="False" Margin="0,0,0,4"
                                              ToolTip="Включить шумозатвор"/>
                                    <TextBlock Text="Порог" Foreground="#FF8080B0" FontSize="8" Margin="0,0,0,1"/>
                                    <Slider x:Name="NoiseGateThreshold" Minimum="-60" Maximum="0" Value="-30"
                                            Style="{StaticResource ModernSlider}"
                                            ToolTip="Уровень порога шумозатвора"/>
                                    <TextBlock Text="Атака" Foreground="#FF8080B0" FontSize="8" Margin="0,0,0,1"/>
                                    <Slider x:Name="NoiseGateAttack" Minimum="0" Maximum="100" Value="10"
                                            Style="{StaticResource ModernSlider}"
                                            ToolTip="Время атаки шумозатвора (мс)"/>
                                    <TextBlock Text="Освобождение" Foreground="#FF8080B0" FontSize="8" Margin="0,0,0,1"/>
                                    <Slider x:Name="NoiseGateRelease" Minimum="10" Maximum="500" Value="100"
                                            Style="{StaticResource ModernSlider}"
                                            ToolTip="Время освобождения шумозатвора (мс)"/>
                                </StackPanel>
                            </Border>

                            <!-- Devices Quick Access -->
                            <Border Background="#FF16163A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                <Button Content="НАСТРОЙКА УСТРОЙСТВ" Style="{StaticResource AccentButton}"
                                        Click="DevicesButton_Click" FontSize="9"
                                        ToolTip="Быстро перейти к настройкам устройств"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- TAB AREA (Column 1) with Spectrum below -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- TabControl (Row 0) -->
                    <TabControl Grid.Row="0" Margin="4" Background="Transparent" BorderThickness="0"
                                Padding="0" TabStripPlacement="Top">

                        <!-- TAB 1: УСТРОЙСТВА -->
                        <TabItem Header="УСТРОЙСТВА" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                <StackPanel Margin="4">

                                    <TextBlock Text="АУДИО УСТРОЙСТВА" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Input Device -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="Устройство ввода" Foreground="#FF8080B0" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="InputDeviceComboBox" Style="{StaticResource ModernComboBox}"
                                                      DisplayMemberPath="Name" Margin="0,0,0,4"
                                                      ToolTip="Выберите микрофон или устройство ввода"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Output Device -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="Устройство вывода" Foreground="#FF8080B0" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="OutputDeviceComboBox" Style="{StaticResource ModernComboBox}"
                                                      DisplayMemberPath="Name" Margin="0,0,0,4"
                                                      ToolTip="Выберите устройство воспроизведения"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="УПРАВЛЕНИЕ ЗАПИСЬЮ" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Transport Controls -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="ListenBtn" Content="Прослушать"
                                                    Style="{StaticResource AccentButton}" FontSize="9" Margin="0,0,3,0"
                                                    Click="ListenBtn_Click"
                                                    ToolTip="Начать прослушивание микрофона"/>
                                            <Button Grid.Column="1" x:Name="StopBtn" Content="Стоп"
                                                    Style="{StaticResource ModernButton}" FontSize="9" Margin="1,0,1,0"
                                                    Click="StopBtn_Click"
                                                    ToolTip="Остановить прослушивание"/>
                                            <Button Grid.Column="2" x:Name="RecordBtn" Content="Запись"
                                                    Style="{StaticResource DangerButton}" FontSize="9" Margin="1,0,3,0"
                                                    Click="RecordBtn_Click"
                                                    ToolTip="Начать запись"/>
                                            <Button Grid.Column="3" x:Name="StopRecordBtn" Content="Стоп запись"
                                                    Style="{StaticResource ModernButton}" FontSize="9" Margin="3,0,0,0"
                                                    Click="StopRecordBtn_Click"
                                                    ToolTip="Остановить запись"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="ДОПОЛНИТЕЛЬНО" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Pink Noise Toggle -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <CheckBox x:Name="PinkNoiseToggle" Content="Розовый шум"
                                                  Foreground="#FFB0B0D0" FontSize="10" IsChecked="False"
                                                  ToolTip="Воспроизводить розовый шум для настройки акустики"/>
                                    </Border>

                                    <TextBlock Text="СРАВНЕНИЕ A/B" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- A/B Comparison -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="SaveSlotA" Content="Слот A"
                                                    Style="{StaticResource PurpleButton}" FontSize="9" Margin="0,0,3,0"
                                                    Click="SaveSlotA_Click"
                                                    ToolTip="Сохранить текущие настройки в слот A"/>
                                            <Button Grid.Column="1" x:Name="SaveSlotB" Content="Слот B"
                                                    Style="{StaticResource PurpleButton}" FontSize="9" Margin="1,0,3,0"
                                                    Click="SaveSlotB_Click"
                                                    ToolTip="Сохранить текущие настройки в слот B"/>
                                            <Button Grid.Column="2" x:Name="ToggleAB" Content="A/B"
                                                    Style="{StaticResource AccentButton}" FontSize="9" Margin="3,0,0,0"
                                                    Click="ToggleAB_Click"
                                                    ToolTip="Переключаться между слотами A и B"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: ЭКВАЛАЙЗЕР -->
                        <TabItem Header="ЭКВАЛАЙЗЕР" Style="{StaticResource ModernTabItem}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- EQ Header -->
                                <Border Grid.Row="0" Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="10-BAND EQ" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="ResetEQBtn" Content="СБРОС" HorizontalAlignment="Right"
                                                Style="{StaticResource ModernButton}" FontSize="9"
                                                Click="ResetEQ_Click"
                                                ToolTip="Сбросить все полосы эквалайзера в ноль"/>
                                    </Grid>
                                </Border>

                                <!-- EQ Bands -->
                                <Border Grid.Row="1" Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,0">
                                    <ItemsControl ItemsSource="{Binding EqualizerBands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: ЭФФЕКТЫ -->
                        <TabItem Header="ЭФФЕКТЫ" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                <StackPanel Margin="4">

                                    <TextBlock Text="КОМПРЕССОР" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Compressor -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Порог" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="CompressorThreshold" Minimum="-40" Maximum="0" Value="-20"
                                                        Style="{StaticResource AccentSlider}" Margin="6,0,6,0"
                                                        ToolTip="Порог срабатывания компрессора (дБ)"/>
                                                <TextBlock Grid.Column="2" Text="-20" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Коэффициент" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="CompressorRatio" Minimum="1" Maximum="20" Value="4"
                                                        Style="{StaticResource AccentSlider}" Margin="6,0,6,0"
                                                        ToolTip="Коэффициент сжатия"/>
                                                <TextBlock Grid.Column="2" Text="4:1" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Атака" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="CompressorAttack" Minimum="0" Maximum="100" Value="10"
                                                        Style="{StaticResource AccentSlider}" Margin="6,0,6,0"
                                                        ToolTip="Время атаки компрессора (мс)"/>
                                                <TextBlock Grid.Column="2" Text="10" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Освобождение" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="CompressorRelease" Minimum="10" Maximum="500" Value="100"
                                                        Style="{StaticResource AccentSlider}" Margin="6,0,6,0"
                                                        ToolTip="Время освобождения компрессора (мс)"/>
                                                <TextBlock Grid.Column="2" Text="100" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="ЛИМИТЕР" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Limiter -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Порог" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="LimiterThreshold" Minimum="-20" Maximum="0" Value="-1"
                                                        Style="{StaticResource PurpleSlider}" Margin="6,0,6,0"
                                                        ToolTip="Порог лимитера (дБ)"/>
                                                <TextBlock Grid.Column="2" Text="-1" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Освобождение" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="LimiterRelease" Minimum="10" Maximum="500" Value="50"
                                                        Style="{StaticResource PurpleSlider}" Margin="6,0,6,0"
                                                        ToolTip="Время освобождения лимитера (мс)"/>
                                                <TextBlock Grid.Column="2" Text="50" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="ПРЕСЕТЫ ЭФФЕКТОВ" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Effects Presets -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <ComboBox x:Name="EffectsPresetsComboBox" Style="{StaticResource ModernComboBox}"
                                                      Margin="0,0,0,6" DisplayMemberPath="Name"
                                                      ToolTip="Выберите пресет эффектов"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Загрузить" Style="{StaticResource AccentButton}"
                                                        FontSize="9" Margin="0,0,3,0" Click="LoadEffectPreset_Click"
                                                        ToolTip="Загрузить выбранный пресет"/>
                                                <Button Grid.Column="1" Content="Сохранить" Style="{StaticResource ModernButton}"
                                                        FontSize="9" Margin="1,0,3,0" Click="SaveEffectPreset_Click"
                                                        ToolTip="Сохранить текущие эффекты как пресет"/>
                                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource DangerButton}"
                                                        FontSize="9" Margin="3,0,0,0" Click="DeleteEffectPreset_Click"
                                                        ToolTip="Удалить выбранный пресет"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: ГОЛОС -->
                        <TabItem Header="ГОЛОС" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                <StackPanel Margin="4">

                                    <TextBlock Text="МОРФИНГ ГОЛОСА" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Voice Morphing -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <CheckBox x:Name="VoiceMorphToggle" Content="Морфинг голоса включён"
                                                      Foreground="#FFB0B0D0" FontSize="10" IsChecked="False" Margin="0,0,0,6"
                                                      ToolTip="Включить изменение голоса"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Тон" Foreground="#FF8080B0" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0"
                                                        Style="{StaticResource PurpleSlider}" Margin="6,0,6,0"
                                                        ToolTip="Изменение тона голоса (полутона)"/>
                                                <TextBlock Grid.Column="2" x:Name="PitchDisplayText" Text="0 ст."
                                                       Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="ПРЕСЕТЫ ГОЛОСА" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Voice Presets -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <ComboBox x:Name="VoicePresetsComboBox" Style="{StaticResource ModernComboBox}"
                                                      DisplayMemberPath="Name" Margin="0,0,0,6"
                                                      ToolTip="Выберите пресет голоса"/>
                                            <Button x:Name="ApplyVoicePresetBtn" Content="Применить пресет"
                                                    Style="{StaticResource AccentButton}" FontSize="10"
                                                    Click="ApplyVoicePreset_Click"
                                                    DataContext="{Binding SelectedVoicePreset, ElementName=VoicePresetsComboBox}"
                                                    ToolTip="Применить выбранный пресет голоса"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="АВТОМАТИЧЕСКАЯ ПОДДЕРЖКА ГРОМКОСТИ" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- AGC -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <CheckBox x:Name="AGCToggle" Content="АГК включён"
                                                      Foreground="#FFB0B0D0" FontSize="10" IsChecked="False" Margin="0,0,0,6"
                                                      ToolTip="Автоматическая поддержка громкости"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Цель" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="AGCTarget" Minimum="-20" Maximum="0" Value="-12"
                                                        Style="{StaticResource ModernSlider}"
                                                        ToolTip="Целевой уровень громкости (дБ)"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Атака" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="AGCAttack" Minimum="1" Maximum="100" Value="10"
                                                        Style="{StaticResource ModernSlider}"
                                                        ToolTip="Скорость автоматической регулировки (мс)"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Освобождение" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="AGCRelease" Minimum="10" Maximum="500" Value="100"
                                                        Style="{StaticResource ModernSlider}"
                                                        ToolTip="Время освобождения АГК (мс)"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Макс. усил." Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="AGCMaxGain" Minimum="0" Maximum="30" Value="12"
                                                        Style="{StaticResource ModernSlider}"
                                                        ToolTip="Максимальное усиление АГК (дБ)"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: ПРОСТРАНСТВО -->
                        <TabItem Header="ПРОСТРАНСТВО" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                <StackPanel Margin="4">

                                    <TextBlock Text="РЕВЕРБЕРАЦИЯ" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <!-- Reverb -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <CheckBox x:Name="ReverbToggle" Content="Реверберация включена"
                                                      Foreground="#FFB0B0D0" FontSize="10" IsChecked="False" Margin="0,0,0,6"
                                                      ToolTip="Включить эффект реверберации"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Смесь" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="ReverbMix" Minimum="0" Maximum="100" Value="30"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Соотношение сухого и влажного сигнала (%)"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Пространство" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="ReverbRoomSize" Minimum="0" Maximum="100" Value="50"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Размер виртуального помещения (%)"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Затухание" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="ReverbDamping" Minimum="0" Maximum="100" Value="40"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Затухание высоких частот в реверберации (%)"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="ЭХО / ЗАДЕРЖКА" Foreground="#FFB0B0D0" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                                    <!-- Echo / Delay -->
                                    <Border Background="#FF16163A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <CheckBox x:Name="EchoToggle" Content="Эхо включено"
                                                      Foreground="#FFB0B0D0" FontSize="10" IsChecked="False" Margin="0,0,0,6"
                                                      ToolTip="Включить эффект эха"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Задержка" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="EchoDelay" Minimum="10" Maximum="1000" Value="250"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Время задержки эха (мс)"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Смесь" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="EchoMix" Minimum="0" Maximum="100" Value="25"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Уровень эха относительно основного сигнала (%)"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Затухание" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="EchoFeedback" Minimum="0" Maximum="90" Value="40"
                                                        Style="{StaticResource PurpleSlider}"
                                                        ToolTip="Количество повторов эха (%)"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                    <!-- Spectrum Visualizer (Row 1) - below tabs -->
                    <Border Grid.Row="1" Background="#FF12122A" CornerRadius="6" Margin="4,0,4,4" Padding="2">
                        <Canvas x:Name="SpectrumCanvas" ClipToBounds="True"/>
                    </Border>

                </Grid>

            </Grid>

            <!-- ============================================ -->
            <!-- STATUS BAR (Row 2)                           -->
            <!-- ============================================ -->
            <Border Grid.Row="2" Background="#FF0C0C24" BorderThickness="0,1,0,0" BorderBrush="#2A2A5A">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" Width="6" Height="6" Fill="#FF00E676" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusMessage" Text="Готово" Foreground="#FF8080B0" FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="MICSTUDIO PRO v4.0" Foreground="#FF505080" FontSize="8"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

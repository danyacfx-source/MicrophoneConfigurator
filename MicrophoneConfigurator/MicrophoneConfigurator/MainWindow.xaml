<Window x:Class="MicrophoneConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MicrophoneConfigurator"
        xmlns:vm="clr-namespace:MicrophoneConfigurator.Core"
        Title="MicStudio Pro" Height="820" Width="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown" Closing="Window_Closing" StateChanged="Window_StateChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:EqualizerBandModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Label Content="{Binding FrequencyLabel}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="0,0,8,0" FontSize="11"/>
                <Slider Grid.Column="1"
                        Style="{DynamicResource PurpleSlider}"
                        Minimum="-12" Maximum="12"
                        Value="{Binding Gain, Mode=TwoWay}"
                        ToolTip="{Binding FrequencyLabel, StringFormat='Регулировка {0}'}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Gain, StringFormat='{}{0:F1} dB'}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource BgDarkBrush}"
            CornerRadius="16"
            BorderBrush="#2A2A5A"
            BorderThickness="1"
            Effect="{DynamicResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════ TITLE BAR ═══════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgMidBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: logo + title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Ellipse Width="12" Height="12"
                                 Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource SuccessBrush}"
                                                  ShadowDepth="0" BlurRadius="12" Opacity="0.6"/>
                        </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="MICSTUDIO PRO"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: window buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button Content="─"
                                Style="{DynamicResource ModernButton}"
                                Width="36" Height="28"
                                FontSize="14"
                                ToolTip="Свернуть в трей"
                                Click="MinimizeBtn_Click"/>
                        <Button Content="🖥"
                                Style="{DynamicResource ModernButton}"
                                Width="36" Height="28"
                                FontSize="14"
                                Margin="4,0,0,0"
                                ToolTip="Свернуть в системный трей"
                                Click="TrayBtn_Click"/>
                        <Button Content="✕"
                                Style="{DynamicResource DangerButton}"
                                Width="36" Height="28"
                                FontSize="14"
                                Margin="4,0,0,0"
                                ToolTip="Закрыть приложение"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────── LEFT SIDEBAR ─────── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgMidBrush}"
                        CornerRadius="12"
                        Margin="8,8,0,8"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- VU METER -->
                            <Border Background="{DynamicResource BgDarkBrush}"
                                    CornerRadius="8"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="УРОВЕНЬ"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <Grid Height="150">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Channel -->
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource BgDarkBrush}"
                                                CornerRadius="4"
                                                Margin="0,0,3,0"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="VuLeftBar"
                                                        VerticalAlignment="Bottom"
                                                        Height="0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#00C853" Offset="0"/>
                                                            <GradientStop Color="#FFEB3B" Offset="0.6"/>
                                                            <GradientStop Color="#FF5722" Offset="0.85"/>
                                                            <GradientStop Color="#FF1744" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="VuLeftPeak"
                                                        VerticalAlignment="Bottom"
                                                        Height="2" Background="White"
                                                        Margin="0,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Right Channel -->
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource BgDarkBrush}"
                                                CornerRadius="4"
                                                Margin="3,0,0,0"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="VuRightBar"
                                                        VerticalAlignment="Bottom"
                                                        Height="0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#00C853" Offset="0"/>
                                                            <GradientStop Color="#FFEB3B" Offset="0.6"/>
                                                            <GradientStop Color="#FF5722" Offset="0.85"/>
                                                            <GradientStop Color="#FF1744" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="VuRightPeak"
                                                        VerticalAlignment="Bottom"
                                                        Height="2" Background="White"
                                                        Margin="0,0,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Peak label overlay -->
                                        <TextBlock x:Name="VuPeakLabel"
                                                   Text="0.0 dB"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Background="{DynamicResource BgDarkBrush}"
                                                   Padding="4,2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- MASTER VOLUME -->
                            <Border Style="{DynamicResource CardBorder}"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="МАСТЕР ГРОМКОСТЬ"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MasterVolumeSlider"
                                                Style="{DynamicResource ModernSlider}"
                                                Minimum="0" Maximum="2" Value="1"
                                                ToolTip="Регулировка общей громкости вывода"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="VolumeDisplayText"
                                                   Text="100%"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- GAIN REDUCTION METER -->
                            <Border Style="{DynamicResource CardBorder}"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="СНИЖЕНИЕ УСИЛЕНИЯ"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <Border Height="16" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                        <Border x:Name="GainReductionBar"
                                                HorizontalAlignment="Left"
                                                Width="0"
                                                CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource WarningBrush}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource DangerBrush}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="GainReductionLabel"
                                                   Text="0.0 dB"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- NOISE GATE -->
                            <Border Style="{DynamicResource CardBorder}"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="ШУМОВАЯ ДВЕРЬ"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="NoiseGateToggle"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="False"
                                                      ToolTip="Включить или выключить шумовую дверь"/>
                                    </Grid>

                                    <TextBlock Text="Порог"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <Slider x:Name="NoiseGateThreshold"
                                            Style="{DynamicResource PurpleSlider}"
                                            Minimum="-80" Maximum="0" Value="-40"
                                            ToolTip="Уровень шума ниже которого звук будет полностью отсекаться"/>

                                    <TextBlock Text="Атака"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" Margin="0,4,0,4"/>
                                    <Slider x:Name="NoiseGateAttack"
                                            Style="{DynamicResource PurpleSlider}"
                                            Minimum="0" Maximum="100" Value="10"
                                            ToolTip="Время срабатывания шумовой двери в миллисекундах"/>

                                    <TextBlock Text="Отпускание"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" Margin="0,4,0,4"/>
                                    <Slider x:Name="NoiseGateRelease"
                                            Style="{DynamicResource PurpleSlider}"
                                            Minimum="10" Maximum="500" Value="100"
                                            ToolTip="Время отпускания шумовой двери в миллисекундах"/>
                                </StackPanel>
                            </Border>

                            <!-- Devices button -->
                            <Button Content="🔄 Устройства"
                                    Style="{DynamicResource ModernButton}"
                                    Margin="0,4,0,12"
                                    Padding="0,8"
                                    ToolTip="Открыть настройки аудиоустройств"
                                    Click="DevicesButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ─────── TABS AREA ─────── -->
                <TabControl Grid.Column="1"
                            x:Name="MainTabControl"
                            Style="{DynamicResource ModernTabControl}"
                            Margin="8,8,8,8"
                            BorderThickness="0"
                            Background="Transparent">

                    <!-- ═══════ TAB: УСТРОЙСТВА ═══════ -->
                    <TabItem Style="{DynamicResource ModernTabItem}" Header="УСТРОЙСТВА">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <!-- Input Device -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="УСТРОЙСТВО ВВОДА"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox x:Name="InputDeviceComboBox"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ToolTip="Выберите микрофон или устройство ввода"
                                                  DisplayMemberPath="FriendlyName"
                                                  SelectedValue="{Binding SelectedInputDevice}"
                                                  ItemsSource="{Binding InputDevices}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Output Device -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="УСТРОЙСТВО ВЫВОДА"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox x:Name="OutputDeviceComboBox"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ToolTip="Выберите устройство вывода (колонки / наушники)"
                                                  DisplayMemberPath="FriendlyName"
                                                  SelectedValue="{Binding SelectedOutputDevice}"
                                                  ItemsSource="{Binding OutputDevices}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Transport -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="УПРАВЛЕНИЕ"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Content="▶ СЛУШАТЬ"
                                                    Style="{DynamicResource AccentButton}"
                                                    Width="120" Height="36" Margin="4"
                                                    ToolTip="Начать прослушивание микрофона в реальном времени"
                                                    Click="ListenBtn_Click"/>
                                            <Button Content="⏹ СТОП"
                                                    Style="{DynamicResource DangerButton}"
                                                    Width="120" Height="36" Margin="4"
                                                    ToolTip="Остановить прослушивание"
                                                    Click="StopBtn_Click"/>
                                            <Button Content="⏺ ЗАПИСЬ"
                                                    Style="{DynamicResource PurpleButton}"
                                                    Width="120" Height="36" Margin="4"
                                                    ToolTip="Начать запись аудио с микрофона"
                                                    Click="RecordBtn_Click"/>
                                            <Button Content="⏹ СТОП ЗАП."
                                                    Style="{DynamicResource DangerButton}"
                                                    Width="120" Height="36" Margin="4"
                                                    ToolTip="Остановить запись аудио"
                                                    Click="StopRecordBtn_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Pink Noise -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="РОЗОВЫЙ ШУМ"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  —  Тестирование акустики"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="PinkNoiseToggle"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="False"
                                                      ToolTip="Генерировать розовый шум для калибровки и тестирования"/>
                                    </Grid>
                                </Border>

                                <!-- A/B Comparison -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="СРАВНЕНИЕ A / B"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Content="💾 Сохранить A"
                                                    Style="{DynamicResource ModernButton}"
                                                    Width="130" Height="36" Margin="4"
                                                    ToolTip="Сохранить текущие настройки в слот A"
                                                    Click="SaveSlotA_Click"/>
                                            <Button Content="💾 Сохранить B"
                                                    Style="{DynamicResource ModernButton}"
                                                    Width="130" Height="36" Margin="4"
                                                    ToolTip="Сохранить текущие настройки в слот B"
                                                    Click="SaveSlotB_Click"/>
                                            <Button Content="🔀 Переключить"
                                                    Style="{DynamicResource AccentButton}"
                                                    Width="130" Height="36" Margin="4"
                                                    ToolTip="Переключить между настройками A и B"
                                                    Click="ToggleAB_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════ TAB: ЭКВАЛАЙЗЕР ═══════ -->
                    <TabItem Style="{DynamicResource ModernTabItem}" Header="ЭКВАЛАЙЗЕР">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="10-BAND PARAMETRIC EQ"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="СБРОС"
                                            Style="{DynamicResource DangerButton}"
                                            HorizontalAlignment="Right"
                                            Width="80" Height="30"
                                            ToolTip="Сбросить все полосы эквалайзера в ноль"
                                            Click="ResetEQ_Click"/>
                                </Grid>

                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14">
                                    <ItemsControl ItemsSource="{Binding EqualizerBands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Content="{Binding FrequencyLabel}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                                           Margin="0,0,8,0" FontSize="11"/>
                                                    <Slider Grid.Column="1"
                                                            Style="{DynamicResource PurpleSlider}"
                                                            Minimum="-12" Maximum="12"
                                                            Value="{Binding Gain, Mode=TwoWay}"
                                                            ToolTip="{Binding FrequencyLabel, StringFormat='Регулировка полосы {0}'}"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Gain, StringFormat='{}{0:F1} dB'}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               FontSize="11"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════ TAB: ЭФФЕКТЫ ═══════ -->
                    <TabItem Style="{DynamicResource ModernTabItem}" Header="ЭФФЕКТЫ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <!-- Compressor -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="КОМПРЕССОР"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,12"/>

                                        <!-- Row 1: Threshold -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Порог"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="-60" Maximum="0" Value="-20"
                                                    ToolTip="Уровень сигнала при котором компрессор начинает работать (дБ)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="-20 dB"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Row 2: Ratio -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Коэффициент"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="1" Maximum="20" Value="4"
                                                    ToolTip="Степень сжатия сигнала (1:1 — без сжатия, 20:1 — жёсткое)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="4:1"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Row 3: Attack -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Атака"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="200" Value="10"
                                                    ToolTip="Время срабатывания компрессора в миллисекундах"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="10 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Row 4: Release -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Отпускание"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="10" Maximum="1000" Value="200"
                                                    ToolTip="Время отпускания компрессора в миллисекундах"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="200 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Limiter -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ЛИМИТЕР"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,12"/>

                                        <!-- Threshold -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Порог"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="-12" Maximum="0" Value="-1"
                                                    ToolTip="Максимальный уровень сигнала (дБ) — сигнал не будет превышать этот порог"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="-1 dB"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Release -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Отпускание"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="10" Maximum="1000" Value="200"
                                                    ToolTip="Время восстановления лимитера после ограничения сигнала (мс)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="200 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Presets -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ПРЕСЕТЫ ЭФФЕКТОВ"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="EffectsPresetsComboBox"
                                                      Style="{DynamicResource ModernComboBox}"
                                                      ToolTip="Выберите пресет эффектов"
                                                      DisplayMemberPath="Name"
                                                      ItemsSource="{Binding EffectPresets}"/>
                                            <Button Grid.Column="1"
                                                    Content="📥"
                                                    Width="40" Height="32" Margin="6,0,0,0"
                                                    ToolTip="Загрузить выбранный пресет"
                                                    Click="LoadEffectPreset_Click"/>
                                        </Grid>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Content="💾"
                                                    Width="40" Height="32" Margin="4"
                                                    Style="{DynamicResource ModernButton}"
                                                    ToolTip="Сохранить текущие настройки как пресет"
                                                    Click="SaveEffectPreset_Click"/>
                                            <Button Content="🗑️"
                                                    Width="40" Height="32" Margin="4"
                                                    Style="{DynamicResource DangerButton}"
                                                    ToolTip="Удалить выбранный пресет"
                                                    Click="DeleteEffectPreset_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════ TAB: ГОЛОС ═══════ -->
                    <TabItem Style="{DynamicResource ModernTabItem}" Header="ГОЛОС">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <!-- Voice Morphing -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="ИЗМЕНЕНИЕ ГОЛОСА"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="VoiceMorphToggle"
                                                          HorizontalAlignment="Right"
                                                          IsChecked="False"
                                                          ToolTip="Включить или выключить модуляцию голоса"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Высота тона"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    x:Name="PitchSlider"
                                                    Style="{DynamicResource AccentSlider}"
                                                    Minimum="0.5" Maximum="2.0" Value="1.0"
                                                    ToolTip="Множитель высоты тона (0.5 = октава вниз, 2.0 = октава вверх)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="PitchDisplayText"
                                                       Text="1.0x"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <TextBlock Text="Модуляция высоты тона голоса. Значение 1.0 — без изменений. Меньше 1.0 — голос ниже, больше 1.0 — голос выше."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Voice Presets -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ПРЕСЕТЫ ГОЛОСА"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="VoicePresetsComboBox"
                                                      Style="{DynamicResource ModernComboBox}"
                                                      ToolTip="Выберите пресет модуляции голоса"
                                                      DisplayMemberPath="Name"
                                                      SelectedValue="{Binding SelectedVoicePreset}"
                                                      ItemsSource="{Binding VoicePresets}"/>
                                            <Button Grid.Column="1"
                                                    Content="Применить"
                                                    Style="{DynamicResource AccentButton}"
                                                    Width="100" Height="32" Margin="8,0,0,0"
                                                    ToolTip="Применить выбранный пресет голоса"
                                                    Click="ApplyVoicePreset_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto Gain Control -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="АВТО УСИЛЕНИЕ (AGC)"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="AGCToggle"
                                                          HorizontalAlignment="Right"
                                                          IsChecked="False"
                                                          ToolTip="Автоматическая регулировка уровня громкости"/>
                                        </Grid>

                                        <!-- Target Level -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Целевой уровень"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="-30" Maximum="0" Value="-12"
                                                    ToolTip="Желаемый средний уровень громкости в дБ"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="-12 dB"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Max Gain -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Макс. усиление"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="40" Value="20"
                                                    ToolTip="Максимальное усиление которое может применить AGC (дБ)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="20 dB"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Attack -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Атака"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="1" Maximum="500" Value="50"
                                                    ToolTip="Скорость реакции AGC на повышение громкости (мс)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="50 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Release -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Отпускание"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="10" Maximum="2000" Value="500"
                                                    ToolTip="Скорость возврата усиления после снижения громкости (мс)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="500 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ═══════ TAB: ПРОСТРАНСТВО ═══════ -->
                    <TabItem Style="{DynamicResource ModernTabItem}" Header="ПРОСТРАНСТВО">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <!-- Reverb -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="РЕВЕРБЕРАЦИЯ"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="ReverbToggle"
                                                          HorizontalAlignment="Right"
                                                          IsChecked="False"
                                                          ToolTip="Включить или выключить реверберацию"/>
                                        </Grid>

                                        <!-- Wet Mix -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Влажность"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="100" Value="30"
                                                    ToolTip="Соотношение обработанного (реверб) и сухого сигнала в процентах"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="30%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Room Size -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Размер комнаты"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="100" Value="50"
                                                    ToolTip="Размер виртуального помещения — чем больше, тем длиннее хвост ревербации"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="50%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Damping -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Затухание"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="100" Value="40"
                                                    ToolTip="Скорость затухания высоких частот в ревербации — выше значение, тем мягче звук"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="40%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Echo / Delay -->
                                <Border Style="{DynamicResource CardBorder}"
                                        Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="ЭХО / ДЕЛЕЙ"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="EchoToggle"
                                                          HorizontalAlignment="Right"
                                                          IsChecked="False"
                                                          ToolTip="Включить или выключить эффект эха (делея)"/>
                                        </Grid>

                                        <!-- Delay Time -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Задержка"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="10" Maximum="2000" Value="300"
                                                    ToolTip="Время задержки между повторами эха в миллисекундах"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="300 мс"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Feedback -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Обратная связь"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="90" Value="40"
                                                    ToolTip="Количество повторов эха (0 — один повтор, 90 — затяжное эхо)"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="40%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>

                                        <!-- Wet Mix -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Влажность"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <Slider Grid.Column="1"
                                                    Style="{DynamicResource PurpleSlider}"
                                                    Minimum="0" Maximum="100" Value="30"
                                                    ToolTip="Громкость эха относительно исходного сигнала в процентах"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="30%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       FontSize="10"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>

            <!-- ═══════════════════ SPECTRUM VISUALIZER ═══════════════════ -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="8,0,8,8"
                    Height="80"
                    Background="{DynamicResource BgMidBrush}"
                    CornerRadius="8"
                    Padding="4">
                <Canvas x:Name="SpectrumCanvas"
                        ClipToBounds="True"/>
            </Border>

            <!-- ═══════════════════ STATUS BAR ═══════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgMidBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusIndicator"
                             Width="10" Height="10"
                             Fill="{DynamicResource SuccessBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{DynamicResource SuccessBrush}"
                                              ShadowDepth="0" BlurRadius="8" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <TextBlock x:Name="StatusMessage"
                               Text="Готово"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="MICSTUDIO PRO v4.0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
